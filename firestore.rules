rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User root document (holds profile, opening balance, custom categories)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Transactions subcollection (isolated per authenticated user)
      match /transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Budgets subcollection
      match /budgets/{budgetId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Savings Goals subcollection
      match /savingsGoals/{goalId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Custom Categories subcollection
      match /categories/{categoryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Chat History subcollection
      match /chatHistory/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: false;
    }
  }
}
