# ==========================================
# SpendWise AI - Environment Configuration
# ==========================================

# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development

# GROQ AI API CONFIGURATION (Server-Side Only - NEVER expose to client)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# CLIENT CONFIGURATION (Vite prefix VITE_)
# Optional: Set backend API URL if not using Vite proxy default (http://localhost:5000)
VITE_API_BASE_URL=http://localhost:5000

# FIREBASE CONFIGURATION (Client-Side)
# Leave empty to run SpendWise AI in standalone Local/Demo mode (works 100% offline).
# Fill in your Firebase Project values to enable cloud sync and real multi-device authentication.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
